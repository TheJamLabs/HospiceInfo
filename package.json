{
  "name": "hospice-catchment-map",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive map of hospice catchment areas across the UK, approximated from GP practice locations.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "build-data": "node scripts/build-data.mjs",
    "check:layout": "node scripts/check-map-layout.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.6",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "d3-delaunay": "^6.0.4",
    "polygon-clipping": "^0.15.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "xlsx": "^0.18.5"
  }
}
